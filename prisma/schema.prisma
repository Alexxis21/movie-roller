generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  watchlists   Watchlist[]
  favorites    Favorite[]
  customLists  CustomList[]
  ratings      UserRating[]
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  tmdbId    Int
  addedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  tmdbId    Int
  addedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
}

model CustomList {
  id          String     @id @default(uuid())
  userId      String
  title       String
  description String?
  coverUrl    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ListItem[]
}

model ListItem {
  id        String   @id @default(uuid())
  listId    String
  tmdbId    Int
  addedAt   DateTime @default(now())

  customList CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, tmdbId])
}

model UserRating {
  id         String   @id @default(uuid())
  userId     String
  tmdbId     Int
  rating     Float
  reviewText String?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
}
